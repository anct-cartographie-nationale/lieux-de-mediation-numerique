{
  "name": "@gouvfr-anct/lieux-de-mediation-numerique",
  "description": "📚 Bibliothèque pour la modélisation des lieux de médiation numérique respectant le standard du schéma de données des lieux de médiation numériques",
  "keywords": [
    "bibliothèque",
    "gouvernement",
    "betagouv",
    "anct",
    "mediation-numerique"
  ],
  "homepage": "https://npmjs.com/package/@gouvfr-anct/lieux-de-mediation-numerique",
  "bugs": {
    "url": "https://github.com/anct-cartographie-nationale/lieux-de-mediation-numerique/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anct-cartographie-nationale/lieux-de-mediation-numerique.git"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "Agence nationale de la cohésion des territoires",
  "version": "0.0.0-development",
  "packageManager": "pnpm@12.3.2",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "type": "commonjs",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "lint": "biome check .",
    "lint.fix": "biome check --write .",
    "lint.architecture": "node scripts/lint-architecture.mjs",
    "lint.commit": "commitlint --from origin/main",
    "lint.publish": "publint && attw --pack .",
    "lint-staged": "lint-staged",
    "ts.check": "tsc --noEmit",
    "test": "vitest",
    "build": "tsdown",
    "prepare": "husky"
  },
  "contributors": [
    {
      "name": "Arthur Belkhayat",
      "email": "arthur.belkhayat@beta.gouv.fr",
      "url": "https://www.linkedin.com/in/arthur-belkhayat/"
    },
    {
      "name": "Marc Gavanier",
      "email": "marc.gavanier@gmail.com",
      "url": "https://www.linkedin.com/in/marc-gavanier/"
    }
  ],
  "dependencies": {
    "fuzzball": "^2.2.3",
    "libphonenumber-js": "^1.13.12",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@swc/core": "^1.16.2",
    "@types/node": "^26.4.1",
    "dependency-cruiser": "^18.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "publint": "^0.3.24",
    "tsdown": "0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
