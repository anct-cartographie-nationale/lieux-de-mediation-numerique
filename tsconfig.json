{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./.tsconfig/tsconfig.base.json",
  "include": ["src/**/*.ts", "tsdown.config.mts"],
  "compilerOptions": {
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "noEmit": true
  }
}
